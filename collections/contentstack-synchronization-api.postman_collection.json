  "item": [
    {
      "id": "559796bd-432c-4efb-b38d-0a969a13ca57",
      "name": "Synchronization",
      "description": {
        "content": "The synchronization endpoints allow developers to sync published content incrementally, enabling efficient local caching and offline-first patterns.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d4cb1593-d8a0-40c5-9eab-04d3a17d03bf",
          "name": "Sync content",
          "request": {
            "name": "Sync content",
            "description": {
              "content": "Initiates an initial sync or continues a paginated sync of all published entries and assets in the stack. Use init=true for the first sync to receive a sync token. Use the sync_token from subsequent responses to fetch only the changes since the last sync.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "stacks",
                "sync"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "init",
                  "value": "<boolean>",
                  "description": "Set to true to initiate the first sync and receive a sync token."
                },
                {
                  "disabled": false,
                  "key": "sync_token",
                  "value": "<string>",
                  "description": "The token received from a previous sync response. Use to fetch only changes since the last sync."
                },
                {
                  "disabled": false,
                  "key": "pagination_token",
                  "value": "<string>",
                  "description": "Token to retrieve the next page of results in a large sync response."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter sync results by content type. Options: entry_published, entry_unpublished, entry_deleted, asset_published, asset_unpublished, asset_deleted, content_type_deleted."
                },
                {
                  "disabled": false,
                  "key": "content_type_uid",
                  "value": "<string>",
                  "description": "Filter sync results to a specific content type UID."
                },
                {
                  "disabled": false,
                  "key": "locale",
                  "value": "<string>",
                  "description": "The locale code to retrieve localized content. Defaults to the default locale of the stack if not specified."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The API key for the Contentstack stack.",
                "key": "api_key",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) The delivery token for the stack environment.",
                "key": "access_token",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
