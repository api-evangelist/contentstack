        {
          "id": "a5acbe55-c6a2-4274-8dd5-243d04a8c5a6",
          "name": "Merge user attributes",
          "request": {
            "name": "Merge user attributes",
            "description": {
              "content": "Merges the attributes of a source user identity into a target user identity. This is used in identity resolution scenarios where an anonymous user record needs to be combined with an authenticated user record upon login, preserving all accumulated behavioral and attribute data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "user-attributes",
                "actions",
                "merge"
              ],
              "host": [
                "{{baseUrl}}"
