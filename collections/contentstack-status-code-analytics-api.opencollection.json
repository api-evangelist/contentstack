{
  "opencollection": "1.0.0",
  "info": {
    "name": "Contentstack Analytics Accounts Status Code Analytics API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Status Code Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get HTTP status code metrics",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.contentstack.io/analytics/v2/status-code",
            "headers": [
              {
                "name": "organization_uid",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns the distribution of HTTP response status codes returned by Contentstack services. Useful for identifying error rates and monitoring API health."
        }
      ]
    }
  ],
  "bundled": true
}