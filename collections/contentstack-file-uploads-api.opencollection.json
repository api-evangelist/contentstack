{
  "opencollection": "1.0.0",
  "info": {
    "name": "Contentstack Analytics Accounts File Uploads API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "File Uploads",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get project upload URL",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.contentstack.io/projects/upload-url"
          },
          "docs": "Generates a pre-signed URL valid for 10 minutes for uploading a project build artifact file. Use this URL to upload your build package before triggering a deployment."
        }
      ]
    }
  ],
  "bundled": true
}