{
  "opencollection": "1.0.0",
  "info": {
    "name": "Contentstack Analytics Accounts URL Analytics API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "URL Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get top URLs by request count",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.contentstack.io/analytics/v2/top-urls",
            "headers": [
              {
                "name": "organization_uid",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns the most frequently requested URLs within the organization's Contentstack delivery infrastructure over the specified time period."
        }
      ]
    }
  ],
  "bundled": true
}