      "id": "75290181-0f2f-4955-9d0a-6424b1fc628a",
      "name": "Manifest",
      "description": {
        "content": "The manifest endpoint returns a list of all active experiences and their corresponding variants that are activated for the current user based on their attributes and audience membership.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1d5d6acc-95a6-4425-b392-2fe5c433b0fd",
          "name": "Get personalization manifest",
          "request": {
            "name": "Get personalization manifest",
            "description": {
              "content": "Returns a list of all active personalization experiences and their corresponding content variant mappings for the current user. The manifest is evaluated in real-time based on the user's attributes and current audience memberships. This endpoint is called at the beginning of a user session to determine which content variants to display.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "manifest"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The UID of the Contentstack Personalize project.",
                "key": "x-project-uid",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "The unique identifier for the end user. If not provided, a new anonymous user will be created and the UID returned in the response headers.",
                "key": "x-cs-personalize-user-uid",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Original client IP address for geolocation-based targeting.",
                "key": "x-forwarded-for",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "User agent string for device-based targeting rules.",
                "key": "user-agent",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Referring URL for referral-based audience rules.",
                "key": "referer",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Current page URL for page-based audience targeting rules.",
                "key": "x-page-url",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "JSON-encoded object of real-time attribute values to evaluate audience rules against without persisting them.",
                "key": "x-live-attributes",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
