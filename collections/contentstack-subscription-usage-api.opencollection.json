{
  "opencollection": "1.0.0",
  "info": {
    "name": "Contentstack Analytics Accounts Subscription Usage API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Subscription Usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get subscription usage metrics",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.contentstack.io/analytics/v2/subscription-usage",
            "headers": [
              {
                "name": "organization_uid",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns metrics on the organization's Launch resource consumption including the total number of projects, environments, and custom domains relative to plan limits. Queues an async job and returns a jobId for result retrieval."
        }
      ]
    }
  ],
  "bundled": true
}